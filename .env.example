# 数据库配置
# 可选：设置为自定义 SQLite 文件路径
DATA_DIR=./data

# 服务配置
HOST=0.0.0.0
PORT=8322
LOG_LEVEL=info
GIN_MODE=release

# 上报鉴权（可选）
# 设置后，上报接口 /sms/webhook 与 /v1/sms/receive 必须携带密钥
# 建议通过请求头 X-Report-Key 或 Authorization: Bearer <key> 传递
# REPORT_AUTH_KEY=replace-with-a-strong-random-key
# 轮换场景可使用多个 key（逗号分隔），例如：
# REPORT_AUTH_KEYS=old-key,new-key
# 若同时设置 REPORT_AUTH_KEY，会自动并入可用 key 列表

# 可选：Nginx/代理相关
# APP_BASE_PATH=/sms
